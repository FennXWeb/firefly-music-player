{
  "name": "ignifire-music",
  "version": "0.1.37",
  "private": true,
  "description": "A highly customizable, local-first music player for Windows.",
  "author": "Ignifire",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:installer": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.firefly.music",
    "productName": "Ignifire",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/ignifire.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Ignifire-${version}-Setup.exe",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ignifire",
      "uninstallDisplayName": "Ignifire ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Ignifire-${version}-Portable.exe",
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "discord-rpc": "^4.0.1",
    "music-metadata": "^11.14.0"
  }
}
