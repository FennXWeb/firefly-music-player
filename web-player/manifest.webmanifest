{
  "id": "/",
  "name": "Ignifire Music",
  "short_name": "Ignifire",
  "description": "Stream your synced Ignifire music library anywhere.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#09090c",
  "theme_color": "#0b0a0f",
  "categories": ["music", "entertainment"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Albums",
      "short_name": "Albums",
      "url": "/?view=albums",
      "icons": [{"src": "./icons/icon-192.png", "sizes": "192x192"}]
    },
    {
      "name": "Playlists",
      "short_name": "Playlists",
      "url": "/?view=playlists",
      "icons": [{"src": "./icons/icon-192.png", "sizes": "192x192"}]
    }
  ]
}
