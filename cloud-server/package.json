{
  "name": "ignifire-cloud-server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:web": "esbuild web/account.js --bundle --minify --format=iife --outfile=public/account.js",
    "prestart": "npm run build:web",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "auth:generate": "npx auth@1.6.26 generate --config src/auth.js",
    "auth:migrate": "npx auth@1.6.26 migrate --config src/auth.js"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.26",
    "better-auth": "1.6.26",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.12",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.5",
    "twilio": "^6.0.2",
    "@supabase/supabase-js": "^2.0.0"
  }
}
