NODE_ENV=production
PORT=3000
PUBLIC_URL=https://accounts.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ignifire
MYSQL_USER=ignifire_user
MYSQL_PASSWORD=replace-me
STORAGE_ROOT=./storage
STORAGE_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64
DEFAULT_STORAGE_LIMIT_BYTES=157286400
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=accounts@example.com
SMTP_PASSWORD=replace-me
EMAIL_FROM=Ignifire <accounts@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
